#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int next_permutation(int n, char **s) {
    // 1. Find the largest index i such that s[i] < s[i+1]
    int i = n - 2;
    while (i >= 0 && strcmp(s[i], s[i + 1]) >= 0) {
        i--;
    }
    
    // If no such index exists, we are at the last permutation
    if (i < 0) {
        return 0;
    }
    
    // 2. Find the largest index j greater than i such that s[j] > s[i]
    int j = n - 1;
    while (strcmp(s[j], s[i]) <= 0) {
        j--;
    }
    
    // 3. Swap elements at i and j
    char *temp = s[i];
    s[i] = s[j];
    s[j] = temp;
    
    // 4. Reverse the sequence from i+1 to the end of the array
    int left = i + 1;
    int right = n - 1;
    while (left < right) {
        temp = s[left];
        s[left] = s[right];
        s[right] = temp;
        left++;
        right--;
    }
    
    return 1;
}

