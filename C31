#include <stdio.h>
#include <stdlib.h>

// Function to calculate the minimum swaps required to sort the array
int minimumSwaps(int arr_count, int* arr) {
    int swaps = 0;
    int i = 0;
    
    while (i < arr_count) {
        // The correct index for the value arr[i] should be arr[i] - 1
        int correct_index = arr[i] - 1;
        
        if (arr[i] != arr[correct_index]) {
            // Swap the current element with the element at its correct position
            int temp = arr[i];
            arr[i] = arr[correct_index];
            arr[correct_index] = temp;
            
            // Increment swap counter
            swaps++;
            
            // Do not increment i, re-check the new value swapped into arr[i]
        } else {
            // Element is already in the correct position, move to next
            i++;
        }
    }
    return swaps;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 1;

    // Dynamically allocate memory for the array
    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) return 1;
    }

    int result = minimumSwaps(n, arr);
    printf("%d\n", result);

    // Free allocated memory
    free(arr);
    return 0;
}
