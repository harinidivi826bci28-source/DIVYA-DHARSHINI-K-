#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    
    char s[100];
    
    // Read a full line of input string from stdin
    scanf("%[^\n]%*c", s);
      
    // Print "Hello, World!" on the first line
    printf("Hello, World!\n");
    
    // Print the input string s on the next line
    printf("%s\n", s);
    
    return 0;
}
