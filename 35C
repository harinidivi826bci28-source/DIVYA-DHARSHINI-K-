#include <stdio.h>
#include <stdlib.h>

// Helper macro to find the maximum of two numbers
#define MAX(a, b) ((a) > (b) ? (a) : (b))

// Comparator function for qsort to sort intervals by their start time
int compareIntervals(const void *a, const void *b) {
    int startA = (*(const int **)a)[0];
    int startB = (*(const int **)b)[0];
    
    if (startA < startB) return -1;
    if (startA > startB) return 1;
    return 0;
}

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both the returned array and *returnColumnSizes array must be malloced, assume caller calls free().
 */
int** merge(int** intervals, int intervalsSize, int* intervalsColSize, int* returnSize, int** returnColumnSizes) {
    if (intervalsSize <= 0) {
        *returnSize = 0;
        *returnColumnSizes = NULL;
        return NULL;
    }

    // Step 1: Sort intervals by their start times
    qsort(intervals, intervalsSize, sizeof(int*), compareIntervals);

    // Step 2: Allocate memory for the merged results
    int** merged = (int**)malloc(intervalsSize * sizeof(int*));
    *returnColumnSizes = (int*)malloc(intervalsSize * sizeof(int));
    
    int count = 0;

    // Push the first interval to initialize
    merged[count] = (int*)malloc(2 * sizeof(int));
    merged[count][0] = intervals[0][0];
    merged[count][1] = intervals[0][1];
    (*returnColumnSizes)[count] = 2;
    count++;

    // Step 3: Iterate through the remaining intervals and merge if necessary
    for (int i = 1; i < intervalsSize; i++) {
        int currentStart = intervals[i][0];
        int currentEnd = intervals[i][1];
        
        // Fetch the last interval added to the merged array
        int lastEnd = merged[count - 1][1];

        if (currentStart <= lastEnd) {
            // Overlap found: Update the end time of the last merged interval
            merged[count - 1][1] = MAX(lastEnd, currentEnd);
        } else {
            // No overlap: Allocate and add a new interval to the merged array
            merged[count] = (int*)malloc(2 * sizeof(int));
            merged[count][0] = currentStart;
            merged[count][1] = currentEnd;
            (*returnColumnSizes)[count] = 2;
            count++;
        }
    }

    // Step 4: Set the final size of the merged array
    *returnSize = count;
    return merged;
}
